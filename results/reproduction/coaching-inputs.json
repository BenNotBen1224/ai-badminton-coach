  "voices": [
    {
      "id": "hook",
      "text": "一拍之间，动作连起来看。",
      "start_sample": 4800,
      "end_sample": 104403,
      "voice_sha256": "bf57b06cdf287dd4c26220ea6be02a44a409a58b7bb8a4ee8c6b63a5822ce177",
      "gain": 0.9
    },
    {
      "id": "legs",
      "text": "右脚先跨，前膝弯下，左臂跟着打开。脚步回收，再接下一步。",
      "start_sample": 120000,
      "end_sample": 355055,
      "voice_sha256": "70f4096dc1d72066c3d1f8d316a4f29a274a9c94129337ab03c27024ec54c975",
      "gain": 0.9
    },
    {
      "id": "core",
      "text": "跨到底时，上身朝跨步一侧倾，肩线比髋线更斜。回位时，上身逐渐回正。",
      "start_sample": 368000,
      "end_sample": 654727,
      "voice_sha256": "349ae8aed3e46da5bad27a6585c138402bbbb6ab8744125ca057ab3d96a4f42c",
      "gain": 0.9
    },
    {
      "id": "arms",
      "text": "换到另一分，看远端球员：非持拍手先抬，接着往回收，持拍臂顺势上挥。",
      "start_sample": 670400,
      "end_sample": 933804,
      "voice_sha256": "d95100078718f8f7044ca2754fa1f284d1100f9474f374632c8d1b88f87cbdd9",
      "gain": 0.9
    },
    {
      "id": "tactics",
      "text": "她回到半场中部、稍偏反手；对手在后场。练单打时，把回位和下一次向四边移动连起来。",
      "start_sample": 945600,
      "end_sample": 1248728,
      "voice_sha256": "6d6c5baf84d62816db392c8a7fb721180805dd72f1c8566a4312db1aa18f9f40",
      "gain": 0.9
    },
    {
      "id": "recap",
      "text": "腿先跨，手臂接，上身随动，回位再准备。",
      "start_sample": 1260800,
      "end_sample": 1424655,
      "voice_sha256": "4dba1be26cd821cdc634d2ab753824e4528b26fd68e1e208674c2aab1f025057",
      "gain": 0.9
    }
  ]
