        "bytes": 316718,
        "duration_s": 6.597375
      },
      {
        "id": "options",
        "text": "换韩悦被压，王祉怡再往前抢，就打她身后，逼她掉头。防守想翻身，先让对手打不顺。",
        "chunks": [
          "换韩悦被压，",
          "王祉怡再往前抢，",
          "就打她身后，逼她掉头。",
          "防守想翻身，先让对手打不顺。"
        ],
        "start_s": 14.48,
        "slot_end_s": 26.6,
        "file": "voices/base/options.wav",
        "origin": "original Kokoro waveform",
        "sha256": "314f6bae6acc6b8da900498c8c3bcf5a2c96d40da40d78c7490b9fd1fd643d89",
        "bytes": 419620,
        "duration_s": 8.741166666666667
      }
    ],
    "technical": [
      {
        "id": "space-1",
        "text": "韩悦先压正手底角，",
        "start_s": 0.08,
        "slot_end_s": 2.2133333333333334,
        "file": "voices/technical/space-1.wav",
        "origin": "original Kokoro waveform",
        "sha256": "8d874c826bfd122a5db42a6bb07600cc67359a6b26ca95fd440927ba834700cb",
        "bytes": 203880,
        "duration_s": 2.123291666666667
      },
      {
        "id": "space-2",
        "text": "反手斜线拦截，对角调动！",
        "start_s": 2.3133333333333335,
        "slot_end_s": 5.180000000000001,
        "file": "voices/technical/space-2.wav",
        "origin": "original Kokoro waveform",
        "sha256": "2501f541b30fc646e9f2e3cf8a17b1425e84d2fa7488bf53b6e494caf6faf2a9",
        "bytes": 270648,
        "duration_s": 2.818791666666667
      },
      {
        "id": "space-3",
        "text": "神仙防守！",
        "start_s": 5.28,
        "slot_end_s": 6.98,
        "file": "voices/technical/space-3.wav",
        "origin": "original Kokoro waveform",
        "sha256": "f4ce4265f5981eaac7678cbec84237213d6f69722c6101e73ec61defd2e80814",
        "bytes": 122692,
        "duration_s": 1.2775833333333333
      },
      {
        "id": "time-1",
        "text": "王祉怡挑后场，",
        "start_s": 7.08,
        "slot_end_s": 8.98,
        "file": "voices/technical/time-1.wav",
        "origin": "original Kokoro waveform",
        "sha256": "3d109dc7f76e6fd0d3240f11f915ef24526780885be6a38222429075d8f46907",
        "bytes": 155808,
        "duration_s": 1.6225416666666668
      },
      {
        "id": "time-2",
        "text": "韩悦底线暴力跳杀！",
        "start_s": 9.08,
        "slot_end_s": 11.746666666666668,
        "file": "voices/technical/time-2.wav",
        "origin": "original Kokoro waveform",
        "sha256": "3c9fec416427a76921c298e90db7d6c99c15f408e7e028f3263750248a816fa2",
        "bytes": 187132,
        "duration_s": 1.9488333333333334
      },
      {
        "id": "time-3",
        "text": "再吊直线，杀吊结合！",
        "start_s": 11.846666666666668,
        "slot_end_s": 14.38,
        "file": "voices/technical/time-3.wav",
        "origin": "original Kokoro waveform",
        "sha256": "eef05f259ec88420fb8ee001a42d22343e5f8affa4daa8b72a1f7a6fc35a7c5b",
        "bytes": 235216,
        "duration_s": 2.449708333333333
      },
      {
        "id": "options-1",
        "text": "王祉怡后场跳杀！",
        "start_s": 14.48,
        "slot_end_s": 16.413333333333334,
        "file": "voices/technical/options-1.wav",
        "origin": "original Kokoro waveform",
        "sha256": "578d50155ef2c10a6e876dd2e34759dfbdc54e7211fba83ee9b471de131d3d71",
        "bytes": 182516,
        "duration_s": 1.90075
      },
      {
        "id": "options-2",
        "text": "韩悦接杀走对角，把王祉怡拉开！",
        "start_s": 16.513333333333332,
        "slot_end_s": 20.98,
        "file": "voices/technical/options-2.wav",
        "origin": "original Kokoro waveform",
        "sha256": "126f1e74b32b45a77dba1a9de5819c4910f0bbef433fc3be65e7c653732f9712",
        "bytes": 320256,
        "duration_s": 3.335541666666667
      },
      {
        "id": "options-3",
        "text": "两人头顶对角互拉，",
        "start_s": 21.08,
        "slot_end_s": 23.080000000000002,
        "file": "voices/technical/options-3.wav",
        "origin": "original Kokoro waveform",
        "sha256": "0b2a9f48a58c65ec5490f090df40b580dbf4f9a1df0909b0316eb88aa2f7430c",
        "bytes": 184952,
        "duration_s": 1.926125
      },
      {
        "id": "options-4",
        "text": "韩悦下压抢网，连贯拉满！",
        "start_s": 23.18,
        "slot_end_s": 26.580000000000002,
        "file": "voices/technical/options-4.wav",
        "origin": "original Kokoro waveform",
        "sha256": "b18c95bf7c961c644ba77aab0c42c512180f075754c9f37fead3434a3128f4d1",
        "bytes": 261756,
        "duration_s": 2.726166666666667
      }
    ],
    "coaching": [
      {
        "id": "hook",
        "text": "一拍之间，动作连起来看。",
        "start_s": 0.1,
        "slot_end_s": 2.4,
        "file": "voices/coaching/hook.wav",
        "origin": "regenerated MeloTTS from the original caption; original temporary raw waveform was not retained",
        "sha256": "bf57b06cdf287dd4c26220ea6be02a44a409a58b7bb8a4ee8c6b63a5822ce177",
        "bytes": 183064,
        "duration_s": 2.0750566893424036
      },
      {
        "id": "legs",
        "text": "右脚先跨，前膝弯下，左臂跟着打开。脚步回收，再接下一步。",
        "start_s": 2.5,
        "slot_end_s": 7.566666666666666,
        "file": "voices/coaching/legs.wav",
        "origin": "regenerated MeloTTS from the original caption; original temporary raw waveform was not retained",
        "sha256": "70f4096dc1d72066c3d1f8d316a4f29a274a9c94129337ab03c27024ec54c975",
        "bytes": 431956,
        "duration_s": 4.896961451247166
      },
      {
        "id": "core",
        "text": "跨到底时，上身朝跨步一侧倾，肩线比髋线更斜。回位时，上身逐渐回正。",
        "start_s": 7.666666666666666,
        "slot_end_s": 13.866666666666667,
        "file": "voices/coaching/core.wav",
        "origin": "regenerated MeloTTS from the original caption; original temporary raw waveform was not retained",
        "sha256": "349ae8aed3e46da5bad27a6585c138402bbbb6ab8744125ca057ab3d96a4f42c",
        "bytes": 526904,
        "duration_s": 5.973469387755102
      },
      {
        "id": "arms",
        "text": "换到另一分，看远端球员：非持拍手先抬，接着往回收，持拍臂顺势上挥。",
        "start_s": 13.966666666666667,
        "slot_end_s": 19.6,
        "file": "voices/coaching/arms.wav",
        "origin": "regenerated MeloTTS from the original caption; original temporary raw waveform was not retained",
        "sha256": "d95100078718f8f7044ca2754fa1f284d1100f9474f374632c8d1b88f87cbdd9",
        "bytes": 484048,
        "duration_s": 5.487573696145125
      },
      {
        "id": "tactics",
        "text": "她回到半场中部、稍偏反手；对手在后场。练单打时，把回位和下一次向四边移动连起来。",
        "start_s": 19.700000000000003,
        "slot_end_s": 26.166666666666668,
        "file": "voices/coaching/tactics.wav",
        "origin": "regenerated MeloTTS from the original caption; original temporary raw waveform was not retained",
        "sha256": "6d6c5baf84d62816db392c8a7fb721180805dd72f1c8566a4312db1aa18f9f40",
        "bytes": 557040,
        "duration_s": 6.31514739229025
      },
      {
        "id": "recap",
        "text": "腿先跨，手臂接，上身随动，回位再准备。",
        "start_s": 26.26666666666667,
        "slot_end_s": 31.333333333333332,
        "file": "voices/coaching/recap.wav",
        "origin": "regenerated MeloTTS from the original caption; original temporary raw waveform was not retained",
        "sha256": "4dba1be26cd821cdc634d2ab753824e4528b26fd68e1e208674c2aab1f025057",
        "bytes": 301126,
        "duration_s": 3.413628117913832
      }
