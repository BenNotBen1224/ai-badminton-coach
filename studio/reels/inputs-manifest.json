{
  "editions": {
    "base": [
      {
        "id": "space",
        "text": "韩悦调王祉怡，抓的是回位空当。前后拉开，别等她站稳了再打。",
        "chunks": [
          "韩悦调王祉怡，抓的是回位空当。",
          "前后拉开，别等她站稳了再打。"
